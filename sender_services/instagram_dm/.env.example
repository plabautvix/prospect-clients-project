# ─── Sender account ─────────────────────────────────────────────────────────
# A dedicated account, never the main one. In docker compose these come from
# the .env next to docker-compose.yml.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ─── Chrome ─────────────────────────────────────────────────────────────────
# Persisted, so the login survives restarts. Leave empty for a throwaway one.
CHROME_PROFILE_DIR=
# Headless is easier to detect. Keep it false; in Docker it runs under Xvfb.
HEADLESS=false

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8000
SERVICE_API_KEY=dev-service-key-change-me

# ─── Loop ───────────────────────────────────────────────────────────────────
# The pacing itself (gaps, chunks, daily cap, hours) is set on the backend.
MAX_WAIT_SECONDS=60
DISCONNECTED_POLL_SECONDS=10
ERROR_DELAY_SECONDS=30
