# ─── WAHA ───────────────────────────────────────────────────────────────────
WAHA_URL=http://localhost:3000
# Must match WAHA_API_KEY of the waha container.
WAHA_API_KEY=change-me
# WAHA Core serves one session, and it must be called "default".
WAHA_SESSION=default
HTTP_TIMEOUT=30

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8000
SERVICE_API_KEY=dev-service-key-change-me

# ─── Loop ───────────────────────────────────────────────────────────────────
# The pacing itself (gaps, chunks, daily cap, hours) is set on the backend.
MAX_WAIT_SECONDS=60
DISCONNECTED_POLL_SECONDS=10
ERROR_DELAY_SECONDS=15
