# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_NAME=maps_service_client
MQTT_KEEPALIVE=60
MQTT_TOPIC=prospect/maps

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=fila_mensagens
RABBITMQ_ROUTING_KEY=enviar

# Backend API
BACKEND_API_URL=http://localhost:8000

# Firefox (leave empty to use system default)
FIREFOX_BINARY_PATH=
