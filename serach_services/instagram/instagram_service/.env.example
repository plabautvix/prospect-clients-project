# ─── Chrome / search ────────────────────────────────────────────────────────
# Chrome profile directory. Persisting it keeps cookies and the cookie-consent
# choice between runs. Leave empty for a throwaway profile each run.
CHROME_PROFILE_DIR=

# Headless is easier to detect. Keep it false; in Docker use xvfb-run.
HEADLESS=false

# Seconds between queries. The real waits are randomised around this.
SEARCH_DELAY=6

# 0 means no ceiling: go as deep as Google allows. Set a number only to cap a
# run on purpose. Around 11s per page.
MAX_PAGES=0

# ─── MQTT ───────────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_CERT=
MQTT_TOPIC=prospect/instagram

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8000
SERVICE_API_KEY=dev-service-key-change-me
