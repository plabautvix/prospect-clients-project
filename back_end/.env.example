# Copy this file to .env and fill in real values. .env is git-ignored.
# Generate a strong secret (>= 32 bytes) with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-use-a-strong-random-value
JWT_ALGORITHM=HS256
# Token lifetime in minutes.
JWT_EXPIRATION_MINUTES=720
# Shared service-to-service credential. Must match SERVICE_API_KEY of the
# maps-service. Generate with the same command as JWT_SECRET.
SERVICE_API_KEY=change-me-use-a-strong-random-value

# Broker credentials. These must match the mosquitto and rabbitmq users.
# In docker-compose the same values are injected into the brokers and clients.
MQTT_USERNAME=prospect
MQTT_PASSWORD=change-me
RABBITMQ_USER=prospect
RABBITMQ_PASSWORD=change-me

# Broker TLS. In docker-compose these are turned on automatically (ports 8883 /
# 5671) and the CA is mounted at /certs/ca.crt — run scripts/gen-certs.sh first.
# For local dev against plaintext brokers, leave them unset/false.
# MQTT_TLS=true
# MQTT_CA_CERT=/certs/ca.crt
# RABBITMQ_TLS=true
# RABBITMQ_CA_CERT=/certs/ca.crt
