# Copy this file to .env and fill in real values. .env is git-ignored.
# Generate a strong secret (>= 32 bytes) with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-use-a-strong-random-value
JWT_ALGORITHM=HS256
# Token lifetime in minutes.
JWT_EXPIRATION_MINUTES=720
# Shared service-to-service credential. Must match SERVICE_API_KEY of the
# maps-service. Generate with the same command as JWT_SECRET.
SERVICE_API_KEY=change-me-use-a-strong-random-value

# Broker credentials. These must match the mosquitto user.
# In docker-compose the same values are injected into the broker and clients.
MQTT_USERNAME=prospect
MQTT_PASSWORD=change-me

# ─── Campaign sending pace (optional, defaults shown) ─────────────────────────
# Limits are per sender account. Raise them only once an account has been
# sending for a while without trouble.
# SEND_WINDOW_START_HOUR=9
# SEND_WINDOW_END_HOUR=19
# SEND_UTC_OFFSET_HOURS=-3
# WHATSAPP_MIN_GAP_SECONDS=30
# WHATSAPP_MAX_GAP_SECONDS=90
# WHATSAPP_CHUNK_SIZE=15
# WHATSAPP_CHUNK_PAUSE_MIN_SECONDS=900
# WHATSAPP_CHUNK_PAUSE_MAX_SECONDS=1800
# WHATSAPP_DAILY_CAP=150
# INSTAGRAM_MIN_GAP_SECONDS=120
# INSTAGRAM_MAX_GAP_SECONDS=300
# INSTAGRAM_CHUNK_SIZE=5
# INSTAGRAM_CHUNK_PAUSE_MIN_SECONDS=2700
# INSTAGRAM_CHUNK_PAUSE_MAX_SECONDS=5400
# INSTAGRAM_DAILY_CAP=30

# ─── Password reset e-mails ───────────────────────────────────────────────────
# Base URL of the frontend, used in the links sent by e-mail.
APP_URL=http://localhost
# How long a reset link works, in minutes.
# PASSWORD_RESET_EXPIRATION_MINUTES=30
# Outgoing mail. Without SMTP_HOST nothing is sent (a warning is logged).
# docker-compose points these to Mailpit (http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Prospect <nao-responda@prospect.app>
