# Copy this file to .env and fill in real values. .env is git-ignored.
# Generate a strong secret (>= 32 bytes) with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-use-a-strong-random-value
JWT_ALGORITHM=HS256
# Token lifetime in minutes. Keep generous while the user token is still reused
# by the maps-service; lower to ~15-60 once service identities are in place.
JWT_EXPIRATION_MINUTES=720
